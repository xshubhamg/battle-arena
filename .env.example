# TypeSafe AI — get a key at https://console.typesafe.ai/keys
# Used only on the server. Never prefix with NEXT_PUBLIC_.
TYPESAFE_API_KEY=

# Model alias. jev-latest resolves to the newest stable release (jev-1.13.0).
TYPESAFE_MODEL=jev-latest

# live | mock — mock gives deterministic verdicts for tests and offline work.
JUDGE_MODE=live

# Path to the local SQLite database. Only used by the Bun runtime (local dev /
# self-host). On Vercel the app falls back to an in-memory store automatically,
# so leave this unset there.
DATABASE_PATH=./data/battle-arena.db
